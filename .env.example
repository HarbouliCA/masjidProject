# Firebase client config — copy to .env.local and fill in real values.
# Firebase project id: masjid-nour. Service-account keys live only in Functions,
# never here (plan §5).
#
# NEXT_PUBLIC_* vars are inlined at BUILD time — set them before `next build`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=masjid-nour
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA v3 site key, set up in Firebase console)
NEXT_PUBLIC_FIREBASE_APP_CHECK_KEY=

# Server-only Firebase Admin credentials (NEVER expose in NEXT_PUBLIC_*)
# Use one of: FIREBASE_SERVICE_ACCOUNT (JSON string) or GOOGLE_APPLICATION_CREDENTIALS (path)
# These are read at RUNTIME (server actions) — set them in the hosting environment.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional — Node server bind address/port for standalone hosting (Hostinger VPS).
# PM2 sets these in ecosystem.config.cjs; set here only if running directly.
# HOSTNAME=0.0.0.0
# PORT=3000
